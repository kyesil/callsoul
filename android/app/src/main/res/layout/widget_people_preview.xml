<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget list shows for the people widget: four made-up people. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_preview_oval_1"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ayşe"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_preview_oval_2"
            android:gravity="center"
            android:text="B"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Burak"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_preview_oval_3"
            android:gravity="center"
            android:text="C"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Can"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_preview_oval_4"
            android:gravity="center"
            android:text="D"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Deniz"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
