    <string name="settings_quick_menu_title">Swipe up on people</string>
    <string name="settings_quick_menu_body">On the home screen, a quick swipe up on a favourite or a most talked person opens message, call and WhatsApp actions around their photo.</string>
    <string name="settings_backup_last">Last backup: %1$s</string>
    <string name="settings_backup_never">The phone hasn\'t backed up the app yet. Either backup is off, or it hasn\'t run: Android backs apps up about once a day while the phone charges on Wi-Fi.</string>
    <string name="tel_links_title">Links to numbers</string>
    <string name="tel_links_body">Links to phone numbers in other apps still ask which app to open. Pick Better Call Soul and “Always” in the list that opens.</string>
    <string name="tel_links_action">Choose</string>
    <string name="tel_links_lost">Links to phone numbers in other apps ask again which app to open. Pick Better Call Soul and “Always” in the list that opens.</string>
    <string name="tel_links_lost_other">Links to phone numbers in other apps now open in %1$s. On its page that opens, under “Open by default”, clear its defaults.</string>
    <string name="tel_links_row">Links to numbers</string>
    <string name="tel_links_asks">Ask every time</string>
    <string name="tel_links_other">Open in %1$s; there, under “Open by default”, clear its defaults</string>
    <string name="lock_calls_title">Calls on the lock screen</string>
    <string name="lock_calls_body">An incoming call wakes the screen and opens over the lock screen. Without it, a call on a locked phone comes only as a notification.</string>
    <string name="lock_calls_prompt">Android hasn\'t allowed this app to open calls over the lock screen, so a call won\'t wake a sleeping screen. Turn it on for Better Call Soul on the page that opens.</string>
    <string name="lock_calls_action">Turn on</string>
    <string name="whatsapp_calls_prompt">WhatsApp calls are on in Settings, but the app has no notification access, so they don\'t reach the recents. Turn it on for Better Call Soul on the page that opens.</string>
    <string name="setup_whatsapp_body">Show your WhatsApp calls in the recents too? The app reads them from WhatsApp\'s notifications, so Android asks for notification access on the page that opens. Only WhatsApp\'s notifications are looked at and nothing leaves the phone.</string>
    <string name="setup_role_body">Better Call Soul is a phone app. Make it the default phone app first; then it asks for permission to show your calls, recents and contacts.</string>
    <string name="setup_role_settings">Open default apps</string>
    <string name="move_title">Move contacts</string>
    <string name="move_body">Move contacts between the phone, Google and your other accounts, merging those already there</string>
    <string name="move_note">Choose where the contacts come from and where they go. One the other side already has, with the same number or e-mail, is merged into it, the details from where it came taking precedence. Contacts keep their photo, star, labels and ringtone. My card stays where it is.</string>
