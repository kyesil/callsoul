    <string name="settings_history_title">Call history kept on this phone</string>
    <string name="settings_history_body">The app keeps its own copy of your calls for the statistics, and the WhatsApp calls; anything older than this is deleted. Android\'s own call log holds only about the last 500 calls, so a longer time fills up from now on.</string>
    <string name="settings_history_week">1 week</string>
    <string name="settings_history_month">1 month</string>
    <string name="settings_history_shrink">Calls older than the chosen time (%1$s), WhatsApp calls included, will be deleted from the app. The phone\'s own call log isn\'t touched.</string>
    <string name="settings_backup_title">Google backup</string>
    <string name="settings_backup_body">Labels, call history, WhatsApp calls, the recycle bin and settings go into the phone\'s own Google backup, encrypted with your screen lock if you have one, and come back when the app is installed on a new phone. Backup is turned on and off in the phone\'s settings, under Google, Backup.</string>
