    <string name="tel_links_title">Links para números</string>
    <string name="tel_links_body">Links para números de telefone em outros apps ainda perguntam qual app abrir. Escolha Better Call Soul e “Sempre” na lista que abrir.</string>
    <string name="tel_links_action">Escolher</string>
    <string name="tel_links_lost">Links para números de telefone em outros apps voltaram a perguntar qual app abrir. Escolha Better Call Soul e “Sempre” na lista que abrir.</string>
