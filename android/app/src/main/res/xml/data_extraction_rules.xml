<?xml version="1.0" encoding="utf-8"?>
<!-- The phone's own Google backup and a move to a new phone take the app's data along: tags, call
     history, WhatsApp calls, the recycle bin and settings. The debug log and the spot the call pill
     was dragged to on this screen stay behind. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="logs/" />
        <exclude domain="sharedpref" path="call_overlay.xml" />
        <exclude domain="sharedpref" path="backup_watch.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs/" />
        <exclude domain="sharedpref" path="call_overlay.xml" />
        <exclude domain="sharedpref" path="backup_watch.xml" />
    </device-transfer>
</data-extraction-rules>
