    <string name="block_abroad_title">Blocca chiamate dall\'estero</string>
    <string name="block_abroad_body">Le chiamate da prefissi internazionali non in elenco vengono respinte senza squillare. Restano nel registro chiamate, senza notifica. I contatti salvati squillano sempre.</string>
    <string name="block_abroad_home">Il tuo prefisso: +%1$s</string>
