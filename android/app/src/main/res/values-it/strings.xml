    <string name="block_prefix_invalid">Digita l\'inizio di un numero, ad esempio +90 850 o 0850.</string>
    <string name="blocked_title">Numeri bloccati</string>
    <string name="blocked_body">Vedi i numeri bloccati, sbloccali o aggiungine uno</string>
