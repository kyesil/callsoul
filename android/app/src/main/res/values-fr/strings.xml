    <string name="dnd_title">Ne pas déranger</string>
    <string name="dnd_body">Quand Ne pas déranger est activé, Android décide qui peut encore appeler ; les applis ne peuvent plus modifier cette règle. Vos favoris sont vos contacts marqués d\'une étoile.</string>
