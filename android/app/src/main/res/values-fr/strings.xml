    <string name="blocked_body">Voir les numéros bloqués, les débloquer ou en ajouter un</string>
    <string name="blocked_empty">Aucun numéro bloqué.</string>
    <string name="blocked_add">Bloquer un numéro</string>
    <string name="blocked_needs_default">Seule l\'appli Téléphone par défaut peut voir les numéros bloqués. Définissez cette appli par défaut pour les gérer ici.</string>
